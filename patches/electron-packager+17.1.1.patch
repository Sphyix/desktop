diff --git a/node_modules/electron-packager/src/unzip.js b/node_modules/electron-packager/src/unzip.js
index 0000000..0000001 100644
--- a/node_modules/electron-packager/src/unzip.js
+++ b/node_modules/electron-packager/src/unzip.js
@@ -1,7 +1,22 @@
 'use strict'

+const { spawn } = require('child_process')
 const extractZip = require('extract-zip')

 module.exports = async function extractElectronZip (zipPath, targetDir) {
+  if (process.platform === 'win32') {
+    await new Promise((resolve, reject) => {
+      const ps = spawn('powershell.exe', [
+        '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass',
+        '-Command',
+        `Expand-Archive -LiteralPath '${zipPath}' -DestinationPath '${targetDir}' -Force`
+      ], { stdio: 'inherit' })
+      ps.on('close', code => code === 0 ? resolve() : reject(new Error(`Expand-Archive failed with exit code ${code}`)))
+      ps.on('error', reject)
+    })
+    return
+  }
   await extractZip(zipPath, { dir: targetDir })
 }
